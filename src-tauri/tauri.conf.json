{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickLock",
  "version": "0.1.0",
  "identifier": "com.quicklock.claylock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Quick Lock",
        "label": "main",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "center": true
      },
      {
        "title": "Quick Lock",
        "label": "unlock-overlay",
        "url": "index.html?window=unlock",
        "width": 460,
        "height": 400,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "visible": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": ["English"],
        "installerHooks": "installerHooks.nsi"
      }
    }
  }
}
